LLM_PROVIDER=openrouter

# OpenRouter Configuration (Primary)
API_KEY_OPENROUTER=sk-or-your-key-here
MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct

# Grok Configuration (Alternative)
API_KEY_GROK=xai-your-key-here
MODEL_GROK=grok-2-1212

# OpenAI Configuration (Alternative)
API_KEY_OPENAI=sk-proj-your-key-here
MODEL_OPENAI=gpt-4o-mini

# Database Configuration (Production Optional)
DATABASE_URL=postgresql://user:pass@host:port/db

# Server configuration
PORT=10000
# En producción, debe ser la URL pública real (ej. https://dealscout-ai.onrender.com)
APP_BASE_URL=http://localhost:10000
# Lista de orígenes permitidos por CORS separados por comas
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:10000

# Required: Security configurations
JWT_SECRET=super-secret-dealscout-key-2026

# Minimum users required to show global stats on public landing
MIN_USERS_TO_SHOW_STATS=20

# Directory Listing Expiration (default 60 days)
LISTING_EXPIRY_DAYS=60

# Optional: Companies House API Key for UK company lookups (If left empty, the source is skipped gracefully)
COMPANIES_HOUSE_API_KEY=

# Optional Alert Configurations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@dealscout.ai
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Payments Master Configuration
PAYMENTS_ENABLED=false # maestro global toggle, can also be configured dynamically in database via admin panel

# Stripe Gateway Credentials
STRIPE_SECRET_KEY=sk_test_mock_keys_by_default
STRIPE_WEBHOOK_SECRET=whsec_test_mock_webhook_secret

# Cryptocurrency Payment Gateway Credentials
CRYPTO_PROVIDER=coinbase_commerce # or "nowpayments"
CRYPTO_API_KEY=mock_crypto_api_key_by_default
CRYPTO_WEBHOOK_SECRET=mock_crypto_webhook_secret

# Notion Integration Configurations
NOTION_API_KEY=your-notion-api-key-here
NOTION_DATABASE_ID=your-notion-database-id-here
